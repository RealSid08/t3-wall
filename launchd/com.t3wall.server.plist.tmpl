<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.t3wall.server</string>
    <key>ProgramArguments</key>
    <array>
      <string>__DIR__/start-server.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/.t3-wall/server.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.t3-wall/server.log</string>
  </dict>
</plist>
